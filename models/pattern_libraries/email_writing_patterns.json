      "transitions": ["Furthermore", "Additionally", "In addition", "Moreover"],
      "requests": ["I would appreciate", "Could you please", "Would it be possible", "I kindly request"]
    },
    "casual_friendly": {
      "openings": ["Hey there", "Hi!", "Hope you're doing well", "Quick question"],
