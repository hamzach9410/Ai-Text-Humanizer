      "requests": ["Can you", "Would you mind", "Could you help", "Any chance you could"]
    },
    "follow_up": {
      "gentle": ["Just following up", "Wanted to circle back", "Checking in", "Quick follow-up"],
      "urgent": ["Time sensitive", "Urgent follow-up", "Need response ASAP", "Priority"],
      "polite": ["When you get a chance", "No rush", "At your convenience", "Whenever possible"]
