  "formality_markers": {
    "formal": [
      "therefore",
      "furthermore",
      "consequently",
      "moreover",
      "nevertheless"
    ],
    "casual": [
      "so",
      "but",
      "and",
      "plus",
      "also"
    ]
  }
}